import { writeFileSync } from "node:fs";
import { STARTER_INGREDIENTS, STARTER_RECIPES } from "../src/data/catalog.ts";

const q = (v: unknown): string => {
  if (v === undefined || v === null) return "null";
  if (typeof v === "boolean" || typeof v === "number") return String(v);
  if (Array.isArray(v)) return `array[${v.map(q).join(",")}]::text[]`;
  return `'${String(v).replace(/'/g, "''")}'`;
};

const rows = STARTER_INGREDIENTS.map((i) =>
  `(${[
    q(i.id), q(i.name), q(i.category), q(i.foodGroup), q(i.unit),
    q(i.pack?.size), q(i.pack?.label), i.allergens.length ? q(i.allergens) : "'{}'",
    q(i.proteinGroup), q(!!i.ironRich), q(!!i.calciumRich), q(i.color), q(i.minAgeMonths),
  ].join(", ")})`,
);

const json = (v: unknown) => `'${JSON.stringify(v).replace(/'/g, "''")}'::jsonb`;

const recipeRows = STARTER_RECIPES.map((r) =>
  `(${[
    q(r.id), q(r.title), q(r.role), q(r.minAgeMonths), q(r.maxAgeMonths), q(r.proteinGroup),
    q(r.cookMethod), json(r.ingredients), json(r.instructions),
  ].join(", ")})`,
);

const sql = `-- Generated by scripts/gen-seed.mts from src/data/catalog.ts. Do not edit by hand.
-- Fills the starter templates only; each household gets its own copy when it is created (see 0002).
insert into starter_ingredients (id, name, category, food_group, unit, pack_size, pack_label, allergens, protein_group, iron_rich, calcium_rich, color, min_age_months) values
${rows.join(",\n")}
on conflict (id) do update set
  name = excluded.name, category = excluded.category, food_group = excluded.food_group, unit = excluded.unit,
  pack_size = excluded.pack_size, pack_label = excluded.pack_label, allergens = excluded.allergens,
  protein_group = excluded.protein_group, iron_rich = excluded.iron_rich, calcium_rich = excluded.calcium_rich,
  color = excluded.color, min_age_months = excluded.min_age_months;

insert into starter_recipes (id, title, role, min_age_months, max_age_months, protein_group, cook_method, ingredients, instructions) values
${recipeRows.join(",\n")}
on conflict (id) do update set
  title = excluded.title, role = excluded.role, min_age_months = excluded.min_age_months,
  max_age_months = excluded.max_age_months, protein_group = excluded.protein_group,
  cook_method = excluded.cook_method, ingredients = excluded.ingredients,
  instructions = excluded.instructions;
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`wrote ${rows.length} ingredients, ${recipeRows.length} recipes`);
